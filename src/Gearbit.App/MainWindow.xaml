<Window x:Class="Gearbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Gearbit"
        Icon="Assets/gearbit.ico"
        Width="1440" Height="900" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F1420">
  <Grid>
    <wv2:WebView2 x:Name="Web" Visibility="Hidden" />

    <!-- Пока хаб и WebView2 запускаются, и если что-то пошло не так. -->
    <StackPanel x:Name="Splash" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
      <Image Source="Assets/gearbit.ico" Width="96" Height="96" Margin="0,0,0,20" />
      <TextBlock x:Name="SplashTitle" FontSize="24" FontWeight="SemiBold"
                 Foreground="#E8ECF6" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock x:Name="SplashText" FontSize="15" Margin="0,10,0,0" Foreground="#9AA4BC"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
      <StackPanel x:Name="SplashButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed">
        <Button x:Name="InstallButton" Padding="16,8" Margin="0,0,8,0" Click="OnInstallWebView" />
        <Button x:Name="BrowserButton" Padding="16,8" Click="OnOpenInBrowser" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
