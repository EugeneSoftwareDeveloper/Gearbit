<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1515;CA1707;CA1848;CA1859;CA2007</NoWarn>
    <Version>0.1.0</Version>
    <Authors>EugeneSoftwareDeveloper</Authors>
    <Product>BotStudio</Product>
    <RepositoryUrl>https://github.com/EugeneSoftwareDeveloper/BotStudio</RepositoryUrl>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
